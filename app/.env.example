# local | testnet. Anything else falls back to testnet.
NEXT_PUBLIC_NETWORK=testnet
# Overrides the Soroban RPC endpoint for the chosen network.
NEXT_PUBLIC_RPC_URL=
# Overrides the Horizon endpoint, which the app reads native balances from.
NEXT_PUBLIC_HORIZON_URL=
# A deployment record as JSON, for a stack that is not the one compiled into @squaresdk/core.
NEXT_PUBLIC_DEPLOYMENT=
