{
  "name": "@squaresdk/core",
  "version": "0.1.0",
  "description": "Integration library for Square settlement: typed clients, spec hashing and event decoding. The Stellar client is at ./stellar; the EVM client at the root leaves as the Soroban contracts land.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Square-StellarNetwork/square.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi/index.d.ts",
      "default": "./dist/abi/index.js"
    },
    "./stellar": {
      "types": "./dist/stellar/index.d.ts",
      "default": "./dist/stellar/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:abi": "node scripts/generate-abis.mjs",
    "check:events": "node scripts/check-events-documented.mjs",
    "check:selectors": "node scripts/check-deployed-selectors.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:anvil": "ANVIL=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lifecycle": "node --experimental-strip-types scripts/lifecycle.ts",
    "bridge": "node --experimental-strip-types scripts/bridge.ts",
    "check:evidence": "node scripts/check-evidence.mjs"
  },
  "dependencies": {
    "@squaresdk/did-resolver": "file:../did-resolver",
    "@stellar/stellar-sdk": "16.3.0",
    "canonicalize": "^2.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
